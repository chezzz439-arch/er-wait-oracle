# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
# Model used for the prediction step. Sonnet is the cost-effective default for an hourly job.
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- ClickHouse ---
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=er_oracle

# --- Location (San Francisco) ---
SF_LATITUDE=37.7749
SF_LONGITUDE=-122.4194

# --- Scheduling ---
# Standard 5-field cron. Default: top of every hour.
INGEST_CRON=0 * * * *
# Run a prediction after each ingest (true/false)
PREDICT_AFTER_INGEST=true
# How many hours ahead to predict
PREDICT_HORIZON_HOURS=4
